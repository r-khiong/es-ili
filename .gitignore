# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# local working assets (not part of the product)
Jira screenshot/
# Brand design package. Only the files the app actually serves are committed:
# the three SVGs in public/brand/ and the icon set under app/ (favicon.ico,
# apple-icon.png, opengraph-image.png). Source .ai/.pdf/.ttf stay out of git.
esili-brand-kit/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Local Netlify folder
.netlify
